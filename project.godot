; Lumorix City - foundation build
; 4.x / mobile-first architecture
config_version=5

[application]
config/name="Lumorix City"
config/description="Lumorix City — kendi şehrini kur, yönet, geliştir ve keşfet."
config/icon="res://lumorix_city_icon.png"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.015, 0.06, 0.11, 1)
boot_splash/image="res://lumorix_city_splash.png"
boot_splash/show_image=true
boot_splash/fullsize=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/enable_pause_aware_picking=true

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
zoom_in={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
zoom_out={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Buildings"
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.015, 0.06, 0.11, 1)
